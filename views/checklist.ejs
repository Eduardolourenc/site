<%
  const pendingTasks = tasks.filter(t => !t.completed);
  const completedTasks = tasks.filter(t => t.completed);
%>
<style>
  .checklist-container {
    max-width: 1000px;
    margin: 0 auto;
  }
  .add-form {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 3rem;
    background: transparent;
    box-shadow: none;
    padding: 0;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }
  .add-form input {
    flex: 1;
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1rem;
    font-size: 1rem;
    border-radius: var(--radius);
  }
  .add-form button {
    padding: 0 1.5rem;
    border-radius: var(--radius);
  }
  .checklist-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  @media (max-width: 768px) {
    .checklist-columns {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  .section-title {
    font-size: 1.1rem;
    font-weight: 500;
    margin: 0 0 1.5rem;
    color: var(--text-light);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    padding-bottom: 0.5rem;
  }
  .task-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .task-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.2s ease;
  }
  .task-item:last-child {
    border-bottom: none;
  }
  .task-item:hover {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 8px;
  }
  .task-content {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
    font-size: 1.05rem;
  }
  .task-item.completed span {
    text-decoration: line-through;
    opacity: 0.4;
  }
  .task-actions {
    opacity: 0;
    transition: opacity 0.2s;
  }
  .task-item:hover .task-actions {
    opacity: 1;
  }
  .btn-invisible {
    background: none; 
    border: none; 
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s;
  }
  .btn-invisible:hover {
    transform: scale(1.1);
  }
  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: rgba(255, 255, 255, 0.4);
    grid-column: span 2;
  }
  .empty-message {
    color: var(--text-light);
    opacity: 0.4;
    font-style: italic;
    font-size: 0.95rem;
    padding: 1rem 0.5rem;
  }
</style>

<%- include('layout', { body: `
<section class="page-header">
  <div>
    <h1><i class="ph-duotone ph-check-square"></i> Checklist de Estudos</h1>
    <p>Organize os tópicos e matérias que você deseja estudar com foco total.</p>
  </div>
</section>

<div class="checklist-container">
  <form action="/checklist/add" method="POST" class="add-form animate__animated animate__fadeIn">
    <input type="text" name="task" id="task" placeholder="O que você precisa aprender hoje?" required autocomplete="off" />
    <button type="submit" class="btn-primary"><i class="ph-bold ph-plus"></i></button>
  </form>

  <div class="checklist-columns">
    <!-- COLUNA A FAZER -->
    <div class="column">
      <h3 class="section-title animate__animated animate__fadeIn"><i class="ph-fill ph-target"></i> A Fazer</h3>
      <ul class="task-list">
        ${pendingTasks.length > 0 ? pendingTasks.map((task, i) => `
          <li class="task-item animate__animated animate__fadeInUp" style="animation-delay: ${i * 0.05}s">
            <div class="task-content">
              <form action="/checklist/toggle" method="POST" style="margin:0;">
                <input type="hidden" name="id" value="${task.id}" />
                <button type="submit" class="btn-invisible" style="color: var(--text);">
                  <i class="ph ph-circle" style="font-size: 1.6rem;"></i>
                </button>
              </form>
              <span>${task.task.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</span>
            </div>
            <div class="task-actions">
              <form action="/checklist/delete" method="POST" style="margin:0;">
                <input type="hidden" name="id" value="${task.id}" />
                <button type="submit" class="btn-invisible" style="color: #ef4444; font-size: 1.4rem;" title="Remover">
                  <i class="ph-fill ph-trash"></i>
                </button>
              </form>
            </div>
          </li>
        `).join('') : `<p class="empty-message animate__animated animate__fadeIn">Nenhuma tarefa pendente.</p>`}
      </ul>
    </div>

    <!-- COLUNA CONCLUÍDAS -->
    <div class="column">
      <h3 class="section-title animate__animated animate__fadeIn" style="opacity: 0.7;"><i class="ph-fill ph-check-circle"></i> Concluídas</h3>
      <ul class="task-list">
        ${completedTasks.length > 0 ? completedTasks.map((task, i) => `
          <li class="task-item completed animate__animated animate__fadeInUp" style="animation-delay: ${i * 0.05}s">
            <div class="task-content">
              <form action="/checklist/toggle" method="POST" style="margin:0;">
                <input type="hidden" name="id" value="${task.id}" />
                <button type="submit" class="btn-invisible" style="color: var(--primary);">
                  <i class="ph-fill ph-check-circle" style="font-size: 1.6rem;"></i>
                </button>
              </form>
              <span>${task.task.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</span>
            </div>
            <div class="task-actions">
              <form action="/checklist/delete" method="POST" style="margin:0;">
                <input type="hidden" name="id" value="${task.id}" />
                <button type="submit" class="btn-invisible" style="color: #ef4444; font-size: 1.4rem;" title="Remover">
                  <i class="ph-fill ph-trash"></i>
                </button>
              </form>
            </div>
          </li>
        `).join('') : `<p class="empty-message animate__animated animate__fadeIn">Você ainda não concluiu nenhuma tarefa.</p>`}
      </ul>
    </div>
  </div>
</div>
`}) %>